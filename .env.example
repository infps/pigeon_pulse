# Copy to .env and fill in. Everything above the divider is required to boot
# with working pages; everything below degrades a specific feature if missing.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres. DATABASE_URL is the pooled connection the app uses at runtime;
# DIRECT_URL is the unpooled one Prisma needs for migrations (same host without
# the "-pooler" segment on Neon).
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require"

# Signs session cookies. Without it better-auth falls back to a default secret
# and warns at build time — do not ship that. Changing this value invalidates
# every existing session, so everyone has to sign in again.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Base URL the browser prefixes onto every API call. The client builds requests
# as `${NEXT_PUBLIC_API_URL}${endpoint}` and the endpoints already begin with
# "/api/...", so LEAVE THIS EMPTY to keep requests relative to whatever host the
# app is served from.
#
# If it is unset entirely it resolves to the string "undefined" and every
# frontend request 404s — the app loads but no page shows any data.
NEXT_PUBLIC_API_URL=

# Where better-auth's client sends sign-in and session calls. Match the origin
# the app is served from.
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional — the app boots without these; the named feature fails at call time
# ---------------------------------------------------------------------------

# Cloudflare R2. Without these, all image and document upload fails: bird
# photos, event logos and banners, vaccination certificates.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Pusher. Without these, live race updates stop arriving in real time and
# arrivals only appear on refresh.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# PayPal. Without these, every online payment path fails, including bet stakes.
# PAYPAL_MODE is "sandbox" or "live".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Windy. Without these the wind route endpoint returns HTTP 500 and the map
# wind overlay is unavailable.
WINDY_POINT_KEY=
NEXT_PUBLIC_WINDY_MAP_KEY=
