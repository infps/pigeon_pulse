generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTH MODELS (better-auth, TEXT UUIDs — create tables in DB)
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum UserRole {
  BREEDER
  ADMIN
  SUPERADMIN
  BETTOR
}

enum BetCategory {
  BELGIAN
  STANDARD
  WTA
}

enum BetStatus {
  PLACED
  REFUNDED
  WON
  LOST
  PAID
}

enum EventStoreListingStatus {
  AVAILABLE
  SOLD
}

enum RaceFormat {
  STANDARD
  CALCUTTA
}

enum BirdHistoryAction {
  RFID_LINKED
  BASKET_ASSIGNED
  GROUP_ASSIGNED
  GROUP_MOVED
  GROUP_REMOVED
  STATUS_CHANGED
  RELEASED
  ARRIVED
}

enum BirdImageType {
  ARRIVAL
  RACE
  FINAL
}

enum AverageFilterMode {
  ALL
  BY_TYPE
  MANUAL
  COMBINATION
}

enum EventGroupType {
  LOFT
  TAG_COLOR
  STATUS
  DEFAULTER
  CUSTOM
}

enum CalcuttaPhase {
  SETUP
  EARLY_BUY
  AUCTION
  RACE
  COMPLETED
}

enum CalcuttaGroupStatus {
  PENDING
  EARLY_BOUGHT
  BIDDING
  SOLD
  HOUSE
  COMPLETED
}

model User {
  id             String     @id
  name           String
  lastName       String?
  email          String     @unique
  emailVerified  Boolean    @default(false)
  image          String?
  imageKey       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  username       String?    @unique
  displayUsername String?
  country        String?
  state          String?
  city           String?
  address        String?
  postalCode     String?
  phoneNumber    String?
  webAddress     String?
  ssn            String?
  status         UserStatus @default(ACTIVE)
  statusDate     DateTime   @default(now())
  note           String?
  role           UserRole   @default(BREEDER)
  taxNumber      String?
  loftName       String?
  timezone       String?
  legalName      String?
  ssnDocKey      String?
  taxDocKey      String?
  sessions       Session[]
  accounts       Account[]
  breeder        Breeder?
  organizerData  OrganizerData?
  eventMessages  EventMessage[]
  betsPlaced          Bet[]              @relation("BetsPlaced")
  bettorPayments      Payment[]          @relation("BettorPayments")
  calcuttaBids        CalcuttaBid[]
  ownedCalcuttaGroups CalcuttaBetGroup[]

  @@map("Users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("Sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("Accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("Verifications")
}

// ============================================================
// LEGACY — PEOPLE & MEDIA
// ============================================================

model Picture {
  id            Int     @id @default(autoincrement()) @map("ID_PICTURE")
  picture       Bytes?  @map("PICTURE")
  pictureLayout String? @map("PICTURE_LAYOUT")
  pictureType   String? @map("PICTURE_TYPE")

  breeders  Breeder[]
  birds     Bird[]
  payments  Payment[]
}

model OrganizerData {
  id       Int     @id @default(autoincrement()) @map("ID")
  userId   String? @unique @map("USER_ID")
  name     String? @map("NAME")
  email    String  @map("EMAIL")
  phone    String? @map("PHONE")
  cell     String? @map("CELL")
  fax      String? @map("FAX")
  address  String? @map("ADDRESS")
  city     String? @map("CITY")
  state    String? @map("STATE")
  zip      String? @map("ZIP")
  web      String? @map("WEB")
  note     String? @map("NOTE")
  password String? @map("PASSWORD")

  user           User?           @relation(fields: [userId], references: [id])
  events         Event[]
  feeSchemes     FeeScheme[]
  prizeSchemes   PrizeScheme[]
  bettingSchemes BettingScheme[]
}

model Breeder {
  id             Int       @id @default(autoincrement()) @map("ID_BREEDER")
  firstName      String?   @map("FIRST_NAME")
  lastName       String?   @map("LAST_NAME")
  email          String?   @map("EMAIL")
  email2         String?   @map("EMAIL_2")
  phone          String?   @map("PHONE")
  cell           String?   @map("CELL")
  fax            String?   @map("FAX")
  sms            String?   @map("SMS")
  address1       String?   @map("ADDRESS_1")
  city1          String?   @map("CITY_1")
  state1         String?   @map("STATE_1")
  zip1           String?   @map("ZIP_1")
  address2       String?   @map("ADDRESS_2")
  city2          String?   @map("CITY_2")
  state2         String?   @map("STATE_2")
  zip2           String?   @map("ZIP_2")
  country        String?   @map("COUNTRY")
  webAddress     String?   @map("WEB_ADDRESS")
  ssn            String?   @map("SOCIAL_SECURITY_NUMBER")
  taxNumber      String?   @map("TAX_NUMBER")
  loginName      String?   @map("LOGIN_NAME")
  loginPassword  String?   @map("LOGIN_PASSWORD")
  note           String?   @map("NOTE")
  number         Int?      @map("NUMBER")
  status         Int?      @map("STATUS")
  statusDate     DateTime? @map("STATUS_DATE")
  pictureId      Int?      @map("ID_PICTURE")
  isDefaultAddr1 Int?      @map("IS_DEFAULT_ADDRESS_1")
  defNameAgn     String?   @map("DEF_NAME_AGN")
  defNameAs      String?   @map("DEF_NAME_AS")
  userId         String?   @unique @map("USER_ID")

  user             User?            @relation(fields: [userId], references: [id])
  picture          Picture?         @relation(fields: [pictureId], references: [id])
  birds            Bird[]
  eventInventories EventInventory[]
  partners         Partner[]
  teams            Team[]
  payments         Payment[]
  storeListingsOriginal   EventStoreListing[] @relation("OriginalBreeder")
  storeListingsPurchased  EventStoreListing[] @relation("PurchasedByBreeder")

  @@map("Breeders")
}


// ============================================================
// SCHEMES
// ============================================================

enum RaceFeeMode {
  PER_BIRD_PER_RACE
  FLAT_PER_RACE
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  FAILED
  REFUNDED
}

enum RaceItemStatus {
  REGISTERED
  CHECKED_IN
  LOFT_BASKETED
  RELEASED
  ARRIVED
  FOREIGN_BIRD
}

enum BasketPhase {
  LOFT
  RACE
}

enum EventGroupStatus {
  OPEN
  CLOSED
}

enum RaceStatus {
  REGISTERING
  STARTED
  ENDED
}

enum TransportStatus {
  IDLE
  IN_TRANSIT
  ARRIVED
}

model FeeScheme {
  id                 Int          @id @default(autoincrement()) @map("ID_FEE_SCHEME")
  name               String?      @map("FEE_SCHEME_NAME")
  entryFee           Int?         @map("ENTRY_FEE")
  isRefundable       Int?         @map("IS_REFUNDABLE")
  maxBirdCount       Int?         @map("MAX_BIRD_COUNT")
  feesCutPercent     Int?         @map("FEES_CUT_PERCENT")
  minEntryFees       Int?         @map("MIN_ENTRY_FEES")
  maxBackupBirdCount Int?         @map("MAX_BACKUP_BIRD_COUNT")
  isFloatingBackup   Int?         @map("IS_FLOATING_BACKUP")
  hotSpot1Fee        Int?         @map("HOT_SPOT1_FEE")
  hotSpot2Fee        Int?         @map("HOT_SPOT2_FEE")
  hotSpot3Fee        Int?         @map("HOT_SPOT3_FEE")
  hotSpotFinalFee    Int?         @map("HOT_SPOT_FINAL_FEE")
  raceFeeMode        RaceFeeMode  @default(PER_BIRD_PER_RACE) @map("RACE_FEE_MODE")
  createdById        Int?         @map("CREATOR_ID")

  createdBy    OrganizerData? @relation(fields: [createdById], references: [id])
  birdFeeItems BirdFeeItem[]
  seasons      Season[]
  raceTypeFees RaceTypeFeeScheme[]
}

model BirdFeeItem {
  id          Int  @id @default(autoincrement()) @map("ID_PERCH_FEE_ITEM")
  birdNo      Int? @map("BIRD_NO")
  feeSchemeId Int? @map("ID_FEE_SCHEME")
  birdFee     Int? @map("PERCH_FEE")

  feeScheme FeeScheme? @relation(fields: [feeSchemeId], references: [id])

  @@map("BirdFeeItems")
}

model RaceTypeFeeScheme {
  feeSchemeId Int
  raceTypeId  Int
  fee         Float @default(0)

  raceType  RaceType  @relation(fields: [raceTypeId], references: [id], onDelete: Cascade)
  feeScheme FeeScheme @relation(fields: [feeSchemeId], references: [id], onDelete: Cascade)

  @@id([feeSchemeId, raceTypeId])
}

model PrizeScheme {
  id          Int     @id @default(autoincrement()) @map("ID_PRIZE_SCHEME")
  name        String? @map("PRIZE_NAME")
  createdById Int?    @map("CREATOR_ID")

  createdBy       OrganizerData?   @relation(fields: [createdById], references: [id])
  prizeSchemeItems PrizeSchemeItem[]
  finalPrizeSeasons Season[]         @relation("SeasonFinalPrize")
  hotSpot1Seasons  Season[]          @relation("SeasonHotSpot1Prize")
  hotSpot2Seasons  Season[]          @relation("SeasonHotSpot2Prize")
  hotSpot3Seasons  Season[]          @relation("SeasonHotSpot3Prize")
  hotSpotAvgSeasons Season[]         @relation("SeasonHotSpotAvgPrize")
}

model PrizeSchemeItem {
  id            Int    @id @default(autoincrement()) @map("ID_PRIZE_SCHEME_ITEM")
  prizeSchemeId Int?   @map("ID_PRIZE_SCHEME")
  fromPosition  Int?   @map("FROM_POSITION")
  toPosition    Int?   @map("TO_POSITION")
  prizeValue    Float? @map("PRIZE_VALUE")

  prizeScheme PrizeScheme? @relation(fields: [prizeSchemeId], references: [id])
  prizeValues PrizeValue[]
}

model BettingScheme {
  id                Int    @id @default(autoincrement()) @map("ID_BETTING_SCHEME")
  name              String? @map("BETTING_SCHEME_NAME")
  bettingCutPercent Float? @map("BETTING_CUT_PERCENT")
  belgianRatio      Int?   @map("BELGIAN_RATIO")
  belgianShow1      Float? @map("BELGIAN_SHOW_1")
  belgianShow2      Float? @map("BELGIAN_SHOW_2")
  belgianShow3      Float? @map("BELGIAN_SHOW_3")
  belgianShow4      Float? @map("BELGIAN_SHOW_4")
  belgianShow5      Float? @map("BELGIAN_SHOW_5")
  belgianShow6      Float? @map("BELGIAN_SHOW_6")
  belgianShow7      Float? @map("BELGIAN_SHOW_7")
  standardShow1     Float? @map("STANDARD_SHOW_1")
  standardShow2     Float? @map("STANDARD_SHOW_2")
  standardShow3     Float? @map("STANDARD_SHOW_3")
  standardShow4     Float? @map("STANDARD_SHOW_4")
  standardShow5     Float? @map("STANDARD_SHOW_5")
  standardShow6     Float? @map("STANDARD_SHOW_6")
  wta1              Float? @map("WTA_1")
  wta2              Float? @map("WTA_2")
  wta3              Float? @map("WTA_3")
  wta4              Float? @map("WTA_4")
  wta5              Float? @map("WTA_5")
  createdById       Int?   @map("CREATOR_ID")

  createdBy               OrganizerData?          @relation(fields: [createdById], references: [id])
  standardShowPercentages StandardShowPercentage[]
  seasons      Season[]
}

model StandardShowPercentage {
  id              Int  @id @default(autoincrement()) @map("ID_STANDARD_SHOW_PERCENTAGE")
  bettingSchemeId Int? @map("ID_BETTING_SCHEME")
  place           Int? @map("PLACE")
  percValue       Int? @map("PERC_VALUE")

  bettingScheme BettingScheme? @relation(fields: [bettingSchemeId], references: [id])
}

// ============================================================
// RACE MANAGEMENT
// ============================================================

model RaceNumberGroup {
  id Int @id @default(autoincrement()) @map("ID_RACE_NUMBER_GROUP")

  raceTypes        RaceType[]
  eventRaceNumbers EventRaceNumber[]
}

model RaceType {
  id                Int     @id @default(autoincrement()) @map("ID_RACE_TYPE")
  name              String? @map("TYPE_NAME")
  color             String? @map("COLOR")
  numberGroupId     Int?    @map("ID_NUMBER_GROUP")
  isPaymentRequired Boolean @default(false) @map("IS_PAYMENT_REQUIRED")

  numberGroup      RaceNumberGroup?    @relation(fields: [numberGroupId], references: [id])
  races            Race[]
  prizeValues      PrizeValue[]
  raceTypeFees     RaceTypeFeeScheme[]
  raceStations     RaceStation[]
  averageConfigRaceTypes AverageConfigRaceType[]
}

model EventRaceNumber {
  seasonId       Int @map("SEASON_ID")
  numberGroupId  Int @map("ID_NUMBER_GROUP")
  numberRangeFrom Int? @map("NUMBER_RANGE_FROM")
  numberRangeTo   Int? @map("NUMBER_RANGE_TO")

  season      Season          @relation(fields: [seasonId], references: [id])
  numberGroup RaceNumberGroup @relation(fields: [numberGroupId], references: [id])

  @@id([seasonId, numberGroupId])
}

model Race {
  id                 Int       @id @default(autoincrement()) @map("ID_RACE")
  raceTypeId         Int?      @map("ID_RACE_TYPE")
  seasonId           Int?      @map("SEASON_ID")
  raceNumber         Int?      @map("RACE_NUMBER")
  description        String?   @map("DESCRIPTION")
  distance           Int?      @map("DISTANCE")
  location           String?   @map("LOCATION")
  startTime          DateTime? @map("START_TIME")
  endTime            DateTime? @map("END_TIME")
  sunrise            DateTime? @map("SUNRISE")
  sunset             DateTime? @map("SUNSET")
  temperature        String?   @map("TEMPERATURE")
  weather            String?   @map("WEATHER")
  wind               String?   @map("WIND")
  arrivalTemperature String?   @map("ARRIVAL_TEMPERATURE")
  arrivalWeather     String?   @map("ARRIVAL_WEATHER")
  arrivalWind        String?   @map("ARRIVAL_WIND")
  isClosed           Int?      @map("IS_CLOSED")
  season             String?   @map("SEASON")
  name               String    @default("")
  isLive             Boolean   @default(false)
  status             RaceStatus @default(REGISTERING) @map("STATUS")
  raceStationId      Int?      @map("ID_RACE_STATION")
  transportStatus    TransportStatus @default(IDLE) @map("TRANSPORT_STATUS")
  transportStartedAt DateTime?       @map("TRANSPORT_STARTED_AT")
  transportEndedAt   DateTime?       @map("TRANSPORT_ENDED_AT")
  bettingOpen        Boolean         @default(false) @map("BETTING_OPEN")

  seasonRel   Season?      @relation(fields: [seasonId], references: [id])
  raceType    RaceType?    @relation(fields: [raceTypeId], references: [id])
  raceStation RaceStation? @relation(fields: [raceStationId], references: [id])
  truckPings  TruckPing[]
  raceItems RaceItem[]
  bets        Bet[]
  lostBirds Bird[]
  lostHistory    LostHistory[]
  rfidScans      RfidScan[]
  raceItemScans  RaceItemScan[]
  phantomBirds   RacePhantomBird[]
  ignoreBirds    RaceIgnoreBird[]
  arrivalGroups  ArrivalGroup[]
  eventBaskets   EventBasket[]
  averageConfigRaces AverageConfigRace[]
}

model TruckPing {
  id         Int      @id @default(autoincrement())
  raceId     Int
  latitude   Float
  longitude  Float
  speed      Float?
  heading    Float?
  accuracy   Float?
  recordedAt DateTime
  createdAt  DateTime @default(now())

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([raceId, recordedAt])
}

model ArrivalGroup {
  id               Int       @id @default(autoincrement())
  raceId           Int
  name             String?
  arrivalTimeStart DateTime?
  arrivalTimeEnd   DateTime?
  race             Race      @relation(fields: [raceId], references: [id])
  results          RaceItemResult[]
}

model RaceItem {
  id               Int       @id @default(autoincrement()) @map("ID_RACE_ITEM")
  raceId           Int?      @map("ID_RACE")
  inventoryItemId  Int?      @map("ID_INVENTORY_ITEM")
  isLost           Int?      @map("IS_LOST")
  lostRaceId       Int?      @map("LOST_ID_RACE")
  raceBasketTime   DateTime? @map("RACE_BASKET_TIME")
  status           RaceItemStatus      @default(REGISTERED)

  race             Race?               @relation(fields: [raceId], references: [id])
  inventoryItem    EventInventoryItem? @relation(fields: [inventoryItemId], references: [id])
  result           RaceItemResult?
  scans            RaceItemScan[]
  bets             Bet[]
}

model RaceItemResult {
  raceItemId          Int       @id @map("ID_RACE_ITEM")
  arrivalTime         DateTime? @map("ARRIVAL_TIME")
  birdDrop            Int?      @map("BIRD_DROP")
  birdPosition        Int?      @map("BIRD_POSITION")
  birdPositionHotSpot Int?      @map("BIRD_POSITION_HOT_SPOT")
  prizeValue          Float?    @map("PRIZE_VALUE")
  groupId             Int?      @map("ID_ARRIVAL_GROUP")

  raceItem RaceItem      @relation(fields: [raceItemId], references: [id])
  group    ArrivalGroup? @relation(fields: [groupId], references: [id])
}

model RaceItemScan {
  raceId     Int  @map("ID_RACE")
  raceItemId Int  @map("ID_RACE_ITEM")
  scanPos    Int? @map("SCAN_POS")

  race     Race     @relation(fields: [raceId], references: [id])
  raceItem RaceItem @relation(fields: [raceItemId], references: [id])

  @@id([raceId, raceItemId])
}

model RacePhantomBird {
  id          Int       @id @default(autoincrement()) @map("ID_RACE_PHANTOM_BIRD")
  birdId      Int?      @map("ID_BIRD")
  eventId     Int?      @map("ID_EVENT")
  raceId      Int?      @map("ID_RACE")
  rfid        String?   @map("RF_ID")
  arrivalTime DateTime? @map("ARRIVAL_TIME")

  bird  Bird?  @relation(fields: [birdId], references: [id])
  event Event? @relation(fields: [eventId], references: [id])
  race  Race?  @relation(fields: [raceId], references: [id])
}

model RaceIgnoreBird {
  id               Int     @id @default(autoincrement()) @map("ID_IGNORE_BIRD")
  inventoryItemId  Int?    @map("ID_EVENT_INVENTORY_ITEM")
  raceId           Int?    @map("ID_RACE")
  note             String? @map("NOTE")

  inventoryItem EventInventoryItem? @relation(fields: [inventoryItemId], references: [id])
  race          Race?               @relation(fields: [raceId], references: [id])
}

// ============================================================
// EVENTS
// ============================================================

model EventType {
  id          Int     @id @default(autoincrement()) @map("ID_EVENT_TYPE")
  name        String? @map("TYPE_NAME")
  description String? @map("DESCRIPTION")

  events Event[]

  @@map("EventTypes")
}

model Season {
  id                      Int       @id @default(autoincrement())
  name                    String
  startDate               DateTime
  endDate                 DateTime
  isActive                Boolean   @default(false)
  eventId                 Int       @map("EVENT_ID")
  feeSchemeId             Int?      @map("ID_FEE_SCHEME")
  bettingSchemeId         Int?      @map("ID_BETTING_SCHEME")
  finalPrizeSchemeId      Int?      @map("ID_FINAL_PRIZE_SCHEME")
  hotSpot1PrizeSchemeId   Int?      @map("ID_HOT_SPOT1_PRIZE_SCHEME")
  hotSpot2PrizeSchemeId   Int?      @map("ID_HOT_SPOT2_PRIZE_SCHEME")
  hotSpot3PrizeSchemeId   Int?      @map("ID_HOT_SPOT3_PRIZE_SCHEME")
  hotSpotAvgPrizeSchemeId Int?      @map("ID_HOT_SPOT_AVG_PRIZE_SCHEME")

  event            Event          @relation(fields: [eventId], references: [id])
  feeScheme        FeeScheme?     @relation(fields: [feeSchemeId], references: [id])
  bettingScheme    BettingScheme? @relation(fields: [bettingSchemeId], references: [id])
  finalPrize       PrizeScheme?   @relation("SeasonFinalPrize", fields: [finalPrizeSchemeId], references: [id])
  hotSpot1Prize    PrizeScheme?   @relation("SeasonHotSpot1Prize", fields: [hotSpot1PrizeSchemeId], references: [id])
  hotSpot2Prize    PrizeScheme?   @relation("SeasonHotSpot2Prize", fields: [hotSpot2PrizeSchemeId], references: [id])
  hotSpot3Prize    PrizeScheme?   @relation("SeasonHotSpot3Prize", fields: [hotSpot3PrizeSchemeId], references: [id])
  hotSpotAvgPrize  PrizeScheme?   @relation("SeasonHotSpotAvgPrize", fields: [hotSpotAvgPrizeSchemeId], references: [id])

  races            Race[]
  eventInventories EventInventory[]
  eventBaskets     EventBasket[]
  eventRaceNumbers EventRaceNumber[]
  avgWinnerPrizes  AvgWinnerPrizes[]
  prizeValues      PrizeValue[]
  messages         EventMessage[]
  raceStations     RaceStation[]
  storeListings    EventStoreListing[]
  groups           EventGroup[]
  calcuttaConfig   CalcuttaConfig?
  calcuttaBetGroups CalcuttaBetGroup[]
  birdImages       BirdImage[]
  averageConfigs   AverageConfig[]

  @@index([eventId])
  @@map("Seasons")
}

model Event {
  id                      Int       @id @default(autoincrement()) @map("ID_EVENT")
  name                    String?   @map("EVENT_NAME")
  shortName               String?   @map("EVENT_SHORT_NAME")
  eventDate               DateTime? @map("EVENT_DATE")
  eventTypeId             Int?      @map("EVENT_TYPE")
  isOpen                  Int?      @map("IS_OPEN")
  createdById             Int?      @map("CREATOR_ID")
  latitude                Float?    @map("LATITUDE")
  longitude               Float?    @map("LONGITUDE")
  locationAddress         String?   @map("LOCATION_ADDRESS")
  description             String?   @map("DESCRIPTION")
  endDate                 DateTime? @map("END_DATE")
  contactName             String?   @map("CONTACT_NAME")
  contactEmail            String?   @map("CONTACT_EMAIL")
  contactPhone            String?   @map("CONTACT_PHONE")
  contactWebsite          String?   @map("CONTACT_WEBSITE")
  contactAddress          String?   @map("CONTACT_ADDRESS")
  socialYt                String?   @map("SOCIAL_YT")
  socialFb                String?   @map("SOCIAL_FB")
  socialTwitter           String?   @map("SOCIAL_TWITTER")
  socialInsta             String?   @map("SOCIAL_INSTA")
  logoImage               String?   @map("LOGO_IMAGE")
  logoImageKey            String?   @map("LOGO_IMAGE_KEY")
  bannerImage             String?   @map("BANNER_IMAGE")
  bannerImageKey          String?   @map("BANNER_IMAGE_KEY")
  raceFormat              RaceFormat @default(STANDARD)

  eventType        EventType?     @relation(fields: [eventTypeId], references: [id])
  createdBy        OrganizerData? @relation(fields: [createdById], references: [id])
  phantomBirds     RacePhantomBird[]

  seasons          Season[]

  @@map("Events")
}

model RaceStation {
  id        Int      @id @default(autoincrement())
  seasonId  Int
  name      String
  miles     Float?
  km        Float?
  latitude   Float?
  longitude  Float?
  isActive   Boolean  @default(true)
  raceTypeId Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  season   Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  raceType RaceType? @relation(fields: [raceTypeId], references: [id])
  races    Race[]

  @@index([seasonId])
}

model EventMessage {
  id        Int      @id @default(autoincrement()) @map("ID_EVENT_MESSAGE")
  seasonId  Int      @map("SEASON_ID")
  authorId  String   @map("AUTHOR_ID")
  title     String?  @map("TITLE")
  body      String   @map("BODY")
  mediaUrls String[] @map("MEDIA_URLS")
  createdAt DateTime @default(now()) @map("CREATED_AT")
  updatedAt DateTime @updatedAt @map("UPDATED_AT")

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([seasonId, createdAt])
  @@map("EventMessages")
}

model EventInventory {
  id             Int       @id @default(autoincrement()) @map("ID_EVENT_INVENTORY")
  seasonId       Int?      @map("SEASON_ID")
  breederId      Int?      @map("ID_BREEDER")
  teamId         Int?      @map("ID_TEAM")
  reservedBirds  Int?      @map("RESERVED_BIRDS")
  loft           String?   @map("LOFT")
  note           String?   @map("NOTE")
  signInDate     DateTime? @map("SIGN_IN_DATE")
  isWaiting      Int?      @map("IS_WAITING")
  waitingDate    DateTime? @map("WAITING_DATE")
  cashPromised   Boolean   @default(false) @map("CASH_PROMISED")

  season  Season?  @relation(fields: [seasonId], references: [id])
  breeder Breeder? @relation(fields: [breederId], references: [id])
  team    Team?    @relation(fields: [teamId], references: [id])

  items    EventInventoryItem[]
  partners Partner[]
  payments Payment[]
  calcuttaGroupMemberships CalcuttaBetGroupMember[]
}

model EventInventoryItem {
  id                Int       @id @default(autoincrement()) @map("ID_EVENT_INVENTORY_ITEM")
  birdId            Int?      @map("ID_BIRD")
  eventInventoryId  Int?      @map("ID_EVENT_INVENTORY")
  replacedItemId    Int?      @map("ID_REPLACED_ITEM")
  birdNo            Int?      @map("BIRD_NO")
  arrivalDate       DateTime? @map("ARRIVAL_DATE")
  departureDate     DateTime? @map("DEPARTURE_DATE")
  entryFeeValue     Float?    @map("ENTRY_FEE_VALUE")
  entryFeePaid      Int?      @map("ENTRY_FEE_PAID")
  entryRefund       Float?    @map("ENTRY_REFUND")
  perchFeeValue     Float?    @map("PERCH_FEE_VALUE")
  hotSpotFeeValue   Float?    @map("HOT_SPOT_FEE_VALUE")
  raceFeeValue      Float?    @map("RACE_FEE_VALUE")
  hotSpotRefund     Float?    @map("HOT_SPOT_REFUND")
  betsRefund        Float?    @map("BETS_REFUND")
  isBackup          Int?      @map("IS_BACKUP")
  isBetActive       Float?    @map("IS_BET_ACTIVE")
  transferDue       Int?      @map("TRANSFER_DUE")
  belgianShowBet1   Float?    @map("BELGIAN_SHOW_BET_1")
  belgianShowBet2   Float?    @map("BELGIAN_SHOW_BET_2")
  belgianShowBet3   Float?    @map("BELGIAN_SHOW_BET_3")
  belgianShowBet4   Float?    @map("BELGIAN_SHOW_BET_4")
  belgianShowBet5   Float?    @map("BELGIAN_SHOW_BET_5")
  belgianShowBet6   Float?    @map("BELGIAN_SHOW_BET_6")
  belgianShowBet7   Float?    @map("BELGIAN_SHOW_BET_7")
  standardShowBet1  Float?    @map("STANDARD_SHOW_BET_1")
  standardShowBet2  Float?    @map("STANDARD_SHOW_BET_2")
  standardShowBet3  Float?    @map("STANDARD_SHOW_BET_3")
  standardShowBet4  Float?    @map("STANDARD_SHOW_BET_4")
  standardShowBet5  Float?    @map("STANDARD_SHOW_BET_5")
  standardShowBet6  Float?    @map("STANDARD_SHOW_BET_6")
  wtaBet1           Float?    @map("WTA_BET_1")
  wtaBet2           Float?    @map("WTA_BET_2")
  wtaBet3           Float?    @map("WTA_BET_3")
  wtaBet4           Float?    @map("WTA_BET_4")
  wtaBet5           Float?    @map("WTA_BET_5")

  currentGroupId    Int?      @map("ID_CURRENT_GROUP")
  tagColorGroupId   Int?
  statusGroupId     Int?

  eventInventory EventInventory?     @relation(fields: [eventInventoryId], references: [id])
  bird           Bird?               @relation(fields: [birdId], references: [id])
  replacedItem   EventInventoryItem? @relation("ReplacedItem", fields: [replacedItemId], references: [id])
  replacedBy     EventInventoryItem[] @relation("ReplacedItem")
  currentGroup   EventGroup?         @relation("LoftGroupMembers", fields: [currentGroupId], references: [id])
  tagColorGroup  EventGroup?         @relation("TagColorGroupMembers", fields: [tagColorGroupId], references: [id])
  statusGroup    EventGroup?         @relation("StatusGroupMembers", fields: [statusGroupId], references: [id])

  raceItems            RaceItem[]
  basketAssignments    BasketAssignment[]
  ignoreBirds          RaceIgnoreBird[]
  avgWinners           AvgWinnerPrizes[]
  storeListingItems    EventStoreListingItem[]
  groupHistory         BirdGroupHistory[]
  breederHistory       BirdBreederHistory[]
  vaccinationRecords   BirdVaccinationRecord[]
  birdEventHistory     BirdEventHistory[]
}

model Partner {
  breederId        Int @map("ID_BREEDER")
  eventInventoryId Int @map("ID_EVENT_INVENTORY")

  breeder        Breeder        @relation(fields: [breederId], references: [id])
  eventInventory EventInventory @relation(fields: [eventInventoryId], references: [id])

  @@id([breederId, eventInventoryId])
  @@map("Partners")
}

model AvgWinnerPrizes {
  inventoryItemId Int  @id @map("ID_EVENT_INVENTORY_ITEM")
  seasonId        Int? @map("SEASON_ID")
  prizeValue      Int? @map("PRIZE_VALUE")

  season        Season?             @relation(fields: [seasonId], references: [id])
  inventoryItem EventInventoryItem  @relation(fields: [inventoryItemId], references: [id])
}

model PrizeValue {
  id               Int    @id @default(autoincrement()) @map("ID_PRIZE_VALUE")
  seasonId         Int?   @map("SEASON_ID")
  prizeSchemeItemId Int?  @map("ID_PRIZE_SCHEME_ITEM")
  raceTypeId       Int?   @map("ID_RACE_TYPE")
  prizeValue       Float? @map("PRIZE_VALUE")

  season          Season?          @relation(fields: [seasonId], references: [id])
  prizeSchemeItem PrizeSchemeItem? @relation(fields: [prizeSchemeItemId], references: [id])
  raceType        RaceType?        @relation(fields: [raceTypeId], references: [id])
}

model Payment {
  id               Int       @id @default(autoincrement()) @map("ID_PAYMENT")
  eventInventoryId Int?      @map("ID_EVENT_INVENTORY")
  breederId        Int?      @map("ID_BREEDER")
  pictureId        Int?      @map("ID_PICTURE")
  paymentValue     Float?    @map("PAYMENT_VALUE")
  paymentMethod    Int?      @map("PAYMENT_METHOD")
  paymentType      Int?      @map("PAYMENT_TYPE")
  paymentDate      DateTime? @map("PAYMENT_DATE")
  paymentTimestamp DateTime? @map("PAYMENT_TIMESTAMP")
  paymentDesc      String?   @map("PAYMENT_DESC")
  transactionId    String?   @map("TRANSACTION_ID")
  legacyStatus     Int?          @map("STATUS")
  status           PaymentStatus @default(PENDING)
  bettorId         String?       @map("BETTOR_ID")

  eventInventory EventInventory? @relation(fields: [eventInventoryId], references: [id])
  breeder        Breeder?        @relation(fields: [breederId], references: [id])
  picture        Picture?        @relation(fields: [pictureId], references: [id])
  bettor         User?           @relation("BettorPayments", fields: [bettorId], references: [id])

  @@unique([transactionId])
  @@map("Payments")
}

// ============================================================
// BIRDS
// ============================================================

model Bird {
  id                 Int       @id @default(autoincrement()) @map("ID_BIRD")
  band               String?   @map("BAND")
  band1              String?   @map("BAND_1")
  band2              String?   @map("BAND_2")
  band3              String?   @map("BAND_3")
  band4              String?   @map("BAND_4")
  codeMasked         String?   @map("CODE_MASKED")
  birdName           String?   @map("BIRD_NAME")
  color              String?   @map("COLOR")
  rfid               String?   @map("RF_ID")
  sex                Int?      @map("SEX")
  isActive           Int?      @map("IS_ACTIVE")
  isLost             Int?      @map("IS_LOST")
  isRaceVerified     Int?      @map("IS_RACE_VERIFIED")
  playAttentionSound Int?      @map("PLAY_ATTENTION_SOUND")
  lostDate           DateTime? @map("LOST_DATE")
  lostRaceId         Int?      @map("LOST_ID_RACE")
  note               String?   @map("NOTE")
  pictureId          Int?      @map("ID_PICTURE")
  breederId          Int?      @map("breederId")
  fatherId           Int?      @map("ID_FATHER")
  motherId           Int?      @map("ID_MOTHER")
  isPublic           Int?      @default(1) @map("IS_PUBLIC")
  image              String?   @map("IMAGE")
  imageKey           String?   @map("IMAGE_KEY")
  attention          Boolean   @default(false) @map("ATTENTION")

  picture          Picture?  @relation(fields: [pictureId], references: [id])
  breeder          Breeder?  @relation(fields: [breederId], references: [id])
  lostRace         Race?     @relation(fields: [lostRaceId], references: [id])
  father           Bird?     @relation("FatherChildren", fields: [fatherId], references: [id])
  mother           Bird?     @relation("MotherChildren", fields: [motherId], references: [id])
  childrenAsFather Bird[]    @relation("FatherChildren")
  childrenAsMother Bird[]    @relation("MotherChildren")

  inventoryItems EventInventoryItem[]
  lostHistory    LostHistory[]
  rfidScans      RfidScan[]
  phantomBirds   RacePhantomBird[]
  birdImages     BirdImage[]

  @@map("Birds")
}

model BirdImage {
  id       Int           @id @default(autoincrement())
  birdId   Int           @map("BIRD_ID")
  seasonId Int           @map("SEASON_ID")
  type     BirdImageType @map("TYPE")
  url      String        @map("URL")
  s3Key    String        @map("S3_KEY")
  takenAt  DateTime      @default(now()) @map("TAKEN_AT")

  bird   Bird   @relation(fields: [birdId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([birdId, seasonId, type])
  @@map("BirdImages")
}

model AverageConfig {
  id         Int               @id @default(autoincrement())
  seasonId   Int
  name       String
  isPublic   Boolean           @default(false)
  filterMode AverageFilterMode @default(ALL)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  season            Season                  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  selectedRaceTypes AverageConfigRaceType[]
  selectedRaces     AverageConfigRace[]

  @@index([seasonId])
  @@map("AverageConfigs")
}

model AverageConfigRaceType {
  configId   Int
  raceTypeId Int

  config   AverageConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  raceType RaceType      @relation(fields: [raceTypeId], references: [id], onDelete: Cascade)

  @@id([configId, raceTypeId])
  @@map("AverageConfigRaceTypes")
}

model AverageConfigRace {
  configId Int
  raceId   Int

  config AverageConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  race   Race          @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@id([configId, raceId])
  @@map("AverageConfigRaces")
}


model LostHistory {
  id       Int       @id @default(autoincrement()) @map("ID_LOST_HISTORY")
  birdId   Int?      @map("ID_BIRD")
  raceId   Int?      @map("ID_RACE")
  isLost   Int?      @map("IS_LOST")
  lostDate DateTime? @map("LOST_DATE")

  bird Bird? @relation(fields: [birdId], references: [id])
  race Race? @relation(fields: [raceId], references: [id])
}

model RfidScan {
  id        Int      @id @default(autoincrement()) @map("ID_RFID_SCAN")
  rfidTag   String   @map("RFID_TAG")
  scannerId String   @map("SCANNER_ID")
  deviceIp  String?  @map("DEVICE_IP")
  timestamp DateTime @default(now()) @map("TIMESTAMP")
  processed Boolean  @default(false) @map("PROCESSED")
  birdId    Int?     @map("ID_BIRD")
  raceId    Int?     @map("ID_RACE")
  notes     String?  @map("NOTES")
  createdAt DateTime @default(now()) @map("CREATED_AT")

  bird Bird? @relation(fields: [birdId], references: [id])
  race Race? @relation(fields: [raceId], references: [id])

  @@index([rfidTag])
  @@index([scannerId])
  @@index([deviceIp])
  @@index([timestamp])
  @@index([processed])
  @@map("RfidScans")
}

// ============================================================
// OTHER
// ============================================================

model EventBasket {
  id        Int         @id @default(autoincrement()) @map("ID_EVENT_BASKET")
  seasonId  Int         @map("SEASON_ID")
  basketNo  Int         @map("BASKET_NO")
  capacity  Int         @map("CAPACITY")
  phase     BasketPhase @map("PHASE")
  label     String?     @map("LABEL")
  raceId    Int?        @map("ID_RACE")

  season      Season             @relation(fields: [seasonId], references: [id])
  race        Race?              @relation(fields: [raceId], references: [id])
  assignments BasketAssignment[]

  @@unique([seasonId, basketNo, phase, raceId])
  @@index([seasonId, phase, raceId])
  @@map("EventBaskets")
}

model BasketAssignment {
  id                   Int      @id @default(autoincrement()) @map("ID_BASKET_ASSIGNMENT")
  eventBasketId        Int      @map("ID_EVENT_BASKET")
  eventInventoryItemId Int      @map("ID_EVENT_INVENTORY_ITEM")
  assignedAt           DateTime @default(now()) @map("ASSIGNED_AT")

  eventBasket   EventBasket        @relation(fields: [eventBasketId], references: [id], onDelete: Cascade)
  inventoryItem EventInventoryItem @relation(fields: [eventInventoryItemId], references: [id], onDelete: Cascade)

  @@unique([eventInventoryItemId, eventBasketId])
  @@index([eventBasketId])
  @@map("BasketAssignments")
}

model VaccinationRecord {
  id              Int      @id @default(autoincrement())
  eventGroupId    Int
  vaccineName     String
  vaccinationDate DateTime
  vet             String?
  batchNo         String?
  notes           String?
  documentUrl     String?
  documentKey     String?
  createdAt       DateTime @default(now())

  eventGroup  EventGroup             @relation(fields: [eventGroupId], references: [id], onDelete: Cascade)
  birdRecords BirdVaccinationRecord[]
}

model EventGroup {
  id           Int              @id @default(autoincrement())
  seasonId     Int
  name         String
  type         EventGroupType   @default(LOFT)
  status       EventGroupStatus @default(OPEN)
  hasCapacity  Boolean          @default(true)
  capacity     Int?
  color        String?
  statusCodeId Int?
  notes        String?
  isActive     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  season            Season               @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  statusCode        BirdStatusCode?      @relation(fields: [statusCodeId], references: [id])
  members           EventInventoryItem[] @relation("LoftGroupMembers")
  tagColorMembers   EventInventoryItem[] @relation("TagColorGroupMembers")
  statusGroupMems   EventInventoryItem[] @relation("StatusGroupMembers")
  vaccinations      VaccinationRecord[]

  @@index([seasonId, type])
  @@index([seasonId, status])
  @@index([seasonId, type, isActive])
}

model BirdGroupHistory {
  id              Int      @id @default(autoincrement())
  inventoryItemId Int
  fromGroupName   String
  movedAt         DateTime @default(now())

  inventoryItem EventInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}

model BirdBreederHistory {
  id              Int      @id @default(autoincrement())
  inventoryItemId Int
  fromBreederName String
  transferredAt   DateTime @default(now())

  inventoryItem EventInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}

model BirdVaccinationRecord {
  id                  Int      @id @default(autoincrement())
  vaccinationRecordId Int
  inventoryItemId     Int
  recordedAt          DateTime @default(now())

  vaccinationRecord VaccinationRecord  @relation(fields: [vaccinationRecordId], references: [id], onDelete: Cascade)
  inventoryItem     EventInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([vaccinationRecordId, inventoryItemId])
}

model Team {
  id        Int     @id @default(autoincrement()) @map("ID_TEAM")
  name      String? @map("TEAM_NAME")
  breederId Int?    @map("ID_BREEDER")

  breeder Breeder? @relation(fields: [breederId], references: [id])

  eventInventories EventInventory[]

  @@unique([name, breederId])
}

// ============================================================
// BETTING
// ============================================================

model Bet {
  id             Int         @id @default(autoincrement()) @map("ID_BET")
  raceId         Int         @map("ID_RACE")
  raceItemId     Int         @map("ID_RACE_ITEM")
  bettorId       String      @map("ID_BETTOR")
  ownerUserId    String?     @map("ID_OWNER_USER")
  category       BetCategory @map("CATEGORY")
  tierIndex      Int         @map("TIER_INDEX")
  amount         Float       @map("AMOUNT")
  status         BetStatus   @default(PLACED) @map("STATUS")
  payoutValue    Float?      @map("PAYOUT_VALUE")
  stakePaymentId Int?        @map("ID_STAKE_PAYMENT")
  createdAt      DateTime    @default(now()) @map("CREATED_AT")

  race     Race     @relation(fields: [raceId], references: [id])
  raceItem RaceItem @relation(fields: [raceItemId], references: [id])
  bettor   User     @relation("BetsPlaced", fields: [bettorId], references: [id])

  @@unique([raceItemId, category, tierIndex])
  @@index([raceId, category, tierIndex])
  @@map("Bets")
}

// ============================================================
// EVENT STORE (defaulter bird sales)
// ============================================================

model EventStoreListing {
  id                   Int                      @id @default(autoincrement()) @map("ID_EVENT_STORE_LISTING")
  seasonId             Int                      @map("SEASON_ID")
  originalBreederId    Int                      @map("ID_ORIGINAL_BREEDER")
  listingPrice         Float                    @map("LISTING_PRICE")
  status               EventStoreListingStatus  @default(AVAILABLE) @map("STATUS")
  purchasedByBreederId Int?                     @map("ID_PURCHASED_BY")
  purchasedAt          DateTime?                @map("PURCHASED_AT")
  createdAt            DateTime                 @default(now()) @map("CREATED_AT")

  season          Season  @relation(fields: [seasonId], references: [id])
  originalBreeder Breeder @relation("OriginalBreeder", fields: [originalBreederId], references: [id])
  purchasedBy     Breeder? @relation("PurchasedByBreeder", fields: [purchasedByBreederId], references: [id])
  items           EventStoreListingItem[]

  @@map("EventStoreListings")
}

model EventStoreListingItem {
  id                   Int @id @default(autoincrement()) @map("ID_EVENT_STORE_LISTING_ITEM")
  listingId            Int @map("ID_LISTING")
  eventInventoryItemId Int @map("ID_EVENT_INVENTORY_ITEM")

  listing       EventStoreListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  inventoryItem EventInventoryItem @relation(fields: [eventInventoryItemId], references: [id])

  @@map("EventStoreListingItems")
}

// ============================================================
// BIRD STATUS CODES
// ============================================================

model BirdStatusCode {
  id        Int      @id @default(autoincrement()) @map("ID_BIRD_STATUS_CODE")
  code      Int      @unique                       @map("CODE")
  label     String                                  @map("LABEL")
  color     String?                                 @map("COLOR")
  createdAt DateTime @default(now())                @map("CREATED_AT")

  eventGroups EventGroup[]

  @@map("BirdStatusCodes")
}


// ============================================================
// CALCUTTA RACE
// ============================================================

model CalcuttaConfig {
  id                Int           @id @default(autoincrement())
  seasonId          Int           @unique
  pricePerBird      Decimal
  targetGroupSize   Int           @default(15)
  biddingDuration   Int           @default(120)
  antiSnipeDuration Int           @default(10)
  bidRaiseOptions   Int[]
  youtubeStreamUrl  String?
  phase             CalcuttaPhase @default(SETUP)
  activeGroupId     Int?

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}

model CalcuttaBetGroup {
  id              Int                 @id @default(autoincrement())
  seasonId        Int
  groupNumber     Int
  birdCount       Int
  calculatedPrice Decimal
  startingBid     Decimal
  status          CalcuttaGroupStatus @default(PENDING)
  ownerId         String?
  finalPrice      Decimal?
  isHouse         Boolean             @default(false)
  lastBidAt       DateTime?
  createdAt       DateTime            @default(now())

  season  Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  owner   User?  @relation(fields: [ownerId], references: [id])
  members CalcuttaBetGroupMember[]
  bids    CalcuttaBid[]

  @@index([seasonId, status])
}

model CalcuttaBetGroupMember {
  id               Int @id @default(autoincrement())
  groupId          Int
  eventInventoryId Int

  group          CalcuttaBetGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  eventInventory EventInventory   @relation(fields: [eventInventoryId], references: [id])

  @@unique([groupId, eventInventoryId])
  @@index([eventInventoryId])
}

model CalcuttaBid {
  id        Int      @id @default(autoincrement())
  groupId   Int
  bidderId  String
  amount    Decimal
  createdAt DateTime @default(now())

  group  CalcuttaBetGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  bidder User             @relation(fields: [bidderId], references: [id])

  @@index([groupId, amount])
}

// ============================================================
// BIRD EVENT HISTORY
// ============================================================

model BirdEventHistory {
  id                   Int               @id @default(autoincrement())
  eventInventoryItemId Int
  action               BirdHistoryAction
  detail               String?
  groupId              Int?
  basketId             Int?
  performedById        String?
  createdAt            DateTime          @default(now())

  inventoryItem EventInventoryItem @relation(fields: [eventInventoryItemId], references: [id], onDelete: Cascade)

  @@index([eventInventoryItemId, createdAt])
}
